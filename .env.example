# Configuração do Immich
IMMICH_URL=http://localhost:2283
IMMICH_API_KEY=seu_token_api_aqui

# Configuração do Google Photos
GOOGLE_CREDENTIALS_FILE=credentials.json

# Opções de Migração
# Se True, cria os álbuns correspondentes no Google Fotos
SYNC_ALBUMS=true

# Se True, ajusta/injeta metadados EXIF (data e GPS) no binário antes do envio
INJECT_EXIF=true

# Pausa em segundos entre requisições para evitar erro 429 (Too Many Requests) do Google
REQUEST_DELAY_SECONDS=1.5


